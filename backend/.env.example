ANTHROPIC_API_KEY=sk-ant-api03-...
PORT=5001
# Use 5000 on Linux if nothing else needs that port. On macOS, avoid 5000 (AirPlay) unless
# you set SECTIONAL_ALLOW_PORT_5000=1 and disabled AirPlay Receiver.
# SECTIONAL_ALLOW_PORT_5000=1
# optional; default is claude-sonnet-4-6
# ANTHROPIC_MODEL=claude-sonnet-4-6
# Match VITE_BACKEND_PORT in frontend/.env when you change PORT.
# dev only: allow POST /rag/reset
# ALLOW_RAG_RESET=1
# RAG: chroma persist dir (default backend/data/chroma). Lambda often uses /tmp/chroma
# CHROMA_PERSIST_DIR=
# optional embedding model for sentence-transformers (default all-MiniLM-L6-v2)
# SECTIONAL_EMBED_MODEL=
